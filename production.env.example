# ============================================================
# BonfireSite - Configuracao de Producao
# Copie este arquivo para .env e preencha os valores.
#   copy production.env.example .env
# ============================================================

# === Django Core ===
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-chave-grande-e-secreta
# Gere uma chave segura com:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# === Dominio ===
# Coloque aqui o(s) seu(s) dominio(s), separados por virgula.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,seu-dominio.com.br,www.seu-dominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br,https://www.seu-dominio.com.br

# === HTTPS / Seguranca ===
# Use 0 se estiver servindo apenas HTTP local/tunel provisorio.
# Use 1 quando estiver atras de HTTPS (ex: Cloudflare Tunnel).
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_USE_X_FORWARDED_PROTO=0

# === PostgreSQL ===
# O site nao possui mais fallback SQLite. Esta variavel e obrigatoria.
POSTGRES_URL="postgresql://usuario:senha@localhost:5432/postgres?schema=public"

# Alternativa sem URL unica:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=senha
# DB_HOST=localhost
# DB_PORT=5432

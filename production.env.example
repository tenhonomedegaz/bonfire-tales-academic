# ============================================================
# BonfireSite - Configuracao de Producao
# Copie este arquivo para .env e preencha os valores.
#   copy production.env.example .env
# ============================================================

# === Django Core ===
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-chave-grande-e-secreta
# Gere uma chave segura com:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# === Dominio ===
# Coloque aqui o(s) seu(s) dominio(s), separados por virgula.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,seu-dominio.com.br,www.seu-dominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br,https://www.seu-dominio.com.br

# === HTTPS / Seguranca ===
# Use 0 se estiver servindo apenas HTTP local/tunel provisorio.
# Use 1 quando estiver atras de HTTPS (ex: Cloudflare Tunnel).
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_USE_X_FORWARDED_PROTO=0

# === MongoDB (Bot) ===
BOT_MONGO_URI=mongodb+srv://usuario:senha@host/database
BOT_MONGO_DATABASE=nome_do_database

# === Sync SQLite/Mongo ===
SITE_MONGO_SYNC_ENABLED=0
SITE_MONGO_SYNC_INTERVAL_SECONDS=45
SITE_MONGO_SYNC_NAMESPACE=site_sqlite

# === Collections MongoDB ===
BOT_MONGO_SPELLS_COLLECTION=spells
BOT_MONGO_BACKGROUNDS_COLLECTION=backgrounds
BOT_MONGO_BESTIARY_COLLECTION=bestiary
BOT_MONGO_ORGANIZATIONS_COLLECTION=organizations

SITE_MONGO_CLASSES_COLLECTION=site_sqlite_TB_Classe
SITE_MONGO_SUBCLASSES_COLLECTION=site_sqlite_TB_Subclasse
SITE_MONGO_CLASS_FEATURES_COLLECTION=site_sqlite_TB_ClasseHabilidade
SITE_MONGO_CLASS_RESOURCES_COLLECTION=site_sqlite_TB_RecursoClasse
SITE_MONGO_RACES_COLLECTION=site_sqlite_TB_Raca
SITE_MONGO_LINEAGES_COLLECTION=site_sqlite_TB_Linhagem
SITE_MONGO_ESSENCES_COLLECTION=site_sqlite_TB_Essencia
SITE_MONGO_RACIAL_TRAITS_COLLECTION=site_sqlite_TB_TracoRacial
SITE_MONGO_MAP_MARKERS_COLLECTION=site_sqlite_TB_MapMarker
SITE_MONGO_REGIONS_COLLECTION=site_sqlite_TB_Regiao
SITE_MONGO_TERRITORIES_COLLECTION=site_sqlite_TB_Territorio
SITE_MONGO_TALENTS_COLLECTION=site_sqlite_TB_Talento
SITE_MONGO_OPTIONS_COLLECTION=site_sqlite_TB_OpcaoJogo
SITE_MONGO_SPELLS_COLLECTION=spells
SITE_MONGO_BACKGROUNDS_COLLECTION=backgrounds
SITE_MONGO_BESTIARY_COLLECTION=bestiary
SITE_MONGO_ORGANIZATIONS_COLLECTION=organizations
